    "layout": {
      "maxWidth": "1349px",
      "container": "mx-auto w-full max-w-[1349px]",
      "section": "px-4 sm:px-6 lg:px-[calc(28*var(--u))] py-[clamp(28px,4vw,56px)]",
      "htmlLang": "en",
      "htmlClass": "h-full scroll-smooth scroll-pt-[76px] antialiased",
      "bodyClass": "flex min-h-full flex-col overflow-x-hidden bg-white text-[15px] leading-[1.7] text-[#23232b] font-medium [text-rendering:optimizeLegibility] selection:bg-[#86213f] selection:text-white [&_:focus-visible]:rounded-md [&_:focus-visible]:outline-2 [&_:focus-visible]:outline-offset-2 [&_:focus-visible]:outline-[#86213f]",
      "bodyStyle": {
        "fontFamily": "\"DM Sans\", system-ui, sans-serif",
        "--u": "calc(100vw / 1349)"
      }
    },

    "typography": {
      "heroEyebrow": "flex flex-wrap items-center gap-x-2.5 gap-y-1.5 text-[11px] font-semibold uppercase tracking-[0.1em] text-[#23232b] sm:text-[12px] sm:tracking-[0.16em] md:text-[13px] lg:text-[length:calc(18.5*var(--u))] lg:tracking-[0.26em]",
      "heroTitle": "text-[clamp(1.6rem,6vw,3rem)] font-bold leading-[1.18] tracking-tight text-[#23232b] lg:text-[length:calc(78*var(--u))] lg:leading-[calc(74*var(--u))]",
      "heroTitleAccent": "text-[#86213f]",
      "h2": "font-bold tracking-tight text-[clamp(1.4rem,3.5vw,2.5rem)] leading-[1.15] lg:text-[length:calc(52*var(--u))]",
      "p": "text-[clamp(14px,1.4vw,20px)] leading-[1.65] text-[#55555e]",
      "accentColor": "#86213f",
      "textColor": "#23232b",
      "mutedColor": "#55555e"
